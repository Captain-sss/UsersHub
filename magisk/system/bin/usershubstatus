#!/system/bin/sh
# Resolve sibling Core commands without requiring a /system/bin module mount.
# This also works when invoked through /system/bin on Magisk.
UH_BINDIR="${0%/*}"
case "$UH_BINDIR" in
  */system/bin) ;;
  *) UH_BINDIR=/data/adb/modules/usershub_core/system/bin ;;
esac
if [ -d "$UH_BINDIR" ]; then
  PATH="$UH_BINDIR:$PATH"
  export PATH
fi


BASE="/data/adb/usershub"
STATE="$BASE/frozen"
NAMES="$BASE/names"

valid_user() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 10 ] 2>/dev/null && [ "$1" -lt 900 ] 2>/dev/null
}

list_users_raw() {
  cmd user list 2>/dev/null || pm list users 2>/dev/null
}

flag_value() {
  F="$1"
  case "$F" in ''|*[!0-9A-Fa-f]*) echo 0; return ;; esac
  echo $((0x$F))
}

user_kind() {
  V="$(flag_value "$1")"
  if [ $((V & 4096)) -ne 0 ] && [ $((V & 32)) -ne 0 ]; then
    echo WORK
  elif [ $((V & 1024)) -ne 0 ]; then
    echo FULL
  else
    echo OTHER
  fi
}

list_users() {
  list_users_raw | sed -n 's/.*UserInfo{\([0-9][0-9]*\):\([^:}]*\):\([0-9A-Fa-f]*\).*/\1|\2|\3/p' |
  while IFS='|' read -r U N F; do
    valid_user "$U" || continue
    if [ -f "$NAMES/$U" ]; then N="$(tr '\r\n|:{}' '      ' < "$NAMES/$U" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"; fi
    N="$(echo "$N" | tr '|' ' ')"
    echo "$U|$N|$F|$(user_kind "$F")"
  done
}

actual_running() {
  U="$1"
  S="$(am get-started-user-state "$U" 2>/dev/null | tr '\r\n' ' ')"
  echo "$S" | grep -qiE 'RUNNING|BOOTING'
}

shared_ok() {
  U="$1"
  DST="/data/media/$U/Download/Shared"
  # The bind mount may live in init's global mount namespace on KernelSU.
  grep -Fq " $DST " /proc/1/mountinfo 2>/dev/null ||
    grep -Fq " $DST " /proc/mounts 2>/dev/null
}

status_plain() {
  list_users | while IFS='|' read -r U N FLAGS KIND; do
    if [ -f "$STATE/$U.thawing" ]; then
      F="THAWING"
    elif [ -f "$STATE/$U.pending" ] || [ -f "$STATE/$U.scanning" ]; then
      F="FREEZING"
    elif [ -f "$STATE/$U.frozen" ] || [ -f "$STATE/$U.list" ]; then
      F="FROZEN"
    else
      F="NORMAL"
    fi

    case "$F" in
      FROZEN|FREEZING)
        R="STOPPED"; S="NO_SHARED"
        ;;
      *)
        actual_running "$U" && R="RUNNING" || R="STOPPED"
        if [ "$R" = "RUNNING" ] && shared_ok "$U"; then S="SHARED"; else S="NO_SHARED"; fi
        ;;
    esac

    [ -f "$STATE/$U.list" ] && C="$(wc -l < "$STATE/$U.list" 2>/dev/null | tr -d ' ')" || C=0
    DONE="$C"; TOTAL="$C"
    if [ -f "$STATE/$U.progress" ]; then
      P="$(cat "$STATE/$U.progress" 2>/dev/null)"
      DONE="$(echo "$P" | cut -d'|' -f1)"
      TOTAL="$(echo "$P" | cut -d'|' -f2)"
    fi
    [ -n "$DONE" ] || DONE=0
    [ -n "$TOTAL" ] || TOTAL=0
    FAILN="$(grep -c '^failed:' "$STATE/$U.fail" 2>/dev/null || true)"

    echo "$U|$N|$F|$R|$S|$C|$DONE|$TOTAL|$FAILN|$KIND|$FLAGS"
  done
}

case "$1" in
  status|--plain|plain|'') status_plain ;;
  *) echo "usershubstatus [status|--plain]"; exit 1 ;;
esac
