#!/system/bin/sh

BASE="/data/adb/usershub"
STATE="$BASE/frozen"
LOG="$BASE/usershub.log"
BOOT_FLAG="$BASE/boot_freeze_enabled"
PARALLEL_PACKAGES=4
PARALLEL_USERS=2

mkdir -p "$STATE" 2>/dev/null
touch "$LOG" 2>/dev/null
chmod 700 "$BASE" "$STATE" 2>/dev/null
chmod 600 "$LOG" 2>/dev/null

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
die() { echo "ERROR: $*"; log "ERROR $*"; return 1; }

valid_user() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 10 ] 2>/dev/null && [ "$1" -lt 900 ] 2>/dev/null
}

user_exists() { cmd user list 2>/dev/null | grep -q "UserInfo{$1:"; }
current_user() { am get-current-user 2>/dev/null | tr -dc '0-9'; }
list_users_raw() { cmd user list 2>/dev/null || pm list users 2>/dev/null; }

list_users() {
  list_users_raw | sed -n 's/.*UserInfo{\([0-9][0-9]*\):\([^:}]*\):.*/\1|\2/p' |
  while IFS='|' read -r U N; do
    valid_user "$U" || continue
    N="$(echo "$N" | tr '|' ' ')"
    echo "$U|$N"
  done
}

is_running() {
  U="$1"
  R="$(am is-user-stopped "$U" 2>/dev/null | tail -n1 | tr -d '\r\n ')"
  [ "$R" = "false" ] && return 0
  [ "$R" = "true" ] && return 1
  S="$(am get-started-user-state "$U" 2>/dev/null)"
  echo "$S" | grep -qiE 'RUNNING|BOOTING'
}

is_pkg_suspended() {
  U="$1"; P="$2"
  dumpsys package "$P" 2>/dev/null |
    grep -E "User[[:space:]]+$U:|User $U:" |
    grep -qE 'suspended=true|suspended: true'
}

all_packages() {
  U="$1"
  pm list packages --user "$U" 2>/dev/null | sed 's/^package://' | sed '/^$/d' | sort -u
}

system_packages() {
  U="$1"
  pm list packages -s --user "$U" 2>/dev/null | sed 's/^package://' | sed '/^$/d' | sort -u
}

home_packages() {
  U="$1"
  OUT="$(cmd package query-activities --brief --user "$U" -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null)"
  echo "$OUT" | sed -n 's#^[[:space:]]*\([^[:space:]/][^/]*\)/.*#\1#p'
  RES="$(cmd package resolve-activity --brief --user "$U" -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null)"
  echo "$RES" | sed -n 's#^[[:space:]]*\([^[:space:]/][^/]*\)/.*#\1#p'
}

default_ime_pkg() {
  U="$1"
  settings --user "$U" get secure default_input_method 2>/dev/null | sed 's#/.*##' | head -n1
}

critical_packages() {
  U="$1"
  cat <<'EOF'
android
com.android.systemui
com.android.shell
com.captainsss.usershub
com.android.permissioncontroller
com.google.android.permissioncontroller
com.android.packageinstaller
com.google.android.packageinstaller
com.miui.packageinstaller
com.android.providers.settings
com.miui.home
com.android.launcher3
com.mi.android.globallauncher
com.miui.securitycenter
com.lbe.security.miui
EOF
  home_packages "$U"
  default_ime_pkg "$U"
}

shared_ok() {
  U="$1"; DST="/data/media/$U/Download/Shared"
  grep -Fq " $DST " /proc/mounts 2>/dev/null
}

unmount_share() {
  U="$1"
  if command -v usershubshare >/dev/null 2>&1; then
    usershubshare unmount "$U" >/dev/null 2>&1
  fi
}

sync_running_share() {
  U="$1"
  command -v usershubshare >/dev/null 2>&1 || return 0
  usershubshare user "$U" >/dev/null 2>&1
}

prepare_target_files() {
  U="$1"; TMP="$2"
  all_packages "$U" > "$TMP/all"
  system_packages "$U" > "$TMP/system"
  critical_packages "$U" | sed '/^$/d' | sort -u > "$TMP/critical"

  if [ -s "$TMP/critical" ]; then
    grep -Fvx -f "$TMP/critical" "$TMP/all" > "$TMP/targets" 2>/dev/null || true
  else
    cp "$TMP/all" "$TMP/targets"
  fi

  LIST="$STATE/$U.list"
  [ -f "$LIST" ] || : > "$LIST"

  if [ -s "$LIST" ]; then
    grep -Fxf "$TMP/targets" "$LIST" 2>/dev/null | sort -u > "$TMP/list.clean" || true
    mv "$TMP/list.clean" "$LIST"
  fi

  if [ -s "$LIST" ]; then
    grep -Fvx -f "$LIST" "$TMP/targets" > "$TMP/candidates" 2>/dev/null || true
  else
    cp "$TMP/targets" "$TMP/candidates"
  fi
}

suspend_batch_parallel() {
  U="$1"; CAND="$2"; SYS="$3"; LIST="$4"; FAIL="$5"; PROGRESS="$6"; TMP="$7"
  TOTAL="$(wc -l < "$CAND" 2>/dev/null | tr -d ' ')"
  EXISTING="$(wc -l < "$LIST" 2>/dev/null | tr -d ' ')"
  TARGET_TOTAL=$((TOTAL + EXISTING))
  DONE="$EXISTING"
  echo "$DONE|$TARGET_TOTAL" > "$PROGRESS"

  : > "$FAIL"
  IDX=0
  BATCH=0

  while IFS= read -r P; do
    [ -n "$P" ] || continue
    [ -f "$STATE/$U.thawing" ] && break

    IDX=$((IDX + 1))
    BATCH=$((BATCH + 1))
    RES="$TMP/result.$IDX"

    (
      OUT="$(pm suspend --user "$U" "$P" 2>&1)"
      RC=$?
      ONE="$(echo "$OUT" | tr '\r\n|' '   ')"
      if [ "$RC" -eq 0 ] && ! echo "$ONE" | grep -qiE 'Failure|Error|not allowed|cannot suspend|not suspendable'; then
        echo "OK|$P" > "$RES"
      elif is_pkg_suspended "$U" "$P"; then
        echo "OK|$P" > "$RES"
      else
        echo "FAIL|$P|$ONE" > "$RES"
      fi
    ) &

    if [ "$BATCH" -ge "$PARALLEL_PACKAGES" ]; then
      wait
      DONE=$((DONE + BATCH))
      echo "$DONE|$TARGET_TOTAL" > "$PROGRESS"
      BATCH=0
    fi
  done < "$CAND"

  wait
  [ "$BATCH" -gt 0 ] && DONE=$((DONE + BATCH))
  echo "$DONE|$TARGET_TOTAL" > "$PROGRESS"

  for R in "$TMP"/result.*; do
    [ -f "$R" ] || continue
    TYPE="$(cut -d'|' -f1 "$R")"
    P="$(cut -d'|' -f2 "$R")"
    if [ "$TYPE" = "OK" ]; then
      echo "$P" >> "$LIST"
    else
      OUT="$(cut -d'|' -f3- "$R")"
      if grep -Fxq "$P" "$SYS" 2>/dev/null; then
        echo "protected:$P:$OUT" >> "$FAIL"
      else
        echo "failed:$P:$OUT" >> "$FAIL"
      fi
    fi
  done

  sort -u "$LIST" -o "$LIST" 2>/dev/null
  sort -u "$FAIL" -o "$FAIL" 2>/dev/null
  chmod 600 "$LIST" "$FAIL" "$PROGRESS" 2>/dev/null
}

deep_scan_user() {
  U="$1"
  valid_user "$U" || return 1
  user_exists "$U" || return 1
  [ -f "$STATE/$U.thawing" ] && return 0

  LOCK="$STATE/$U.scanlock"
  mkdir "$LOCK" 2>/dev/null || return 0
  touch "$STATE/$U.scanning"
  rm -f "$STATE/$U.pending"

  TMP="$STATE/.scan.$U.$$"
  mkdir -p "$TMP"
  LIST="$STATE/$U.list"
  FAIL="$STATE/$U.fail"
  PROGRESS="$STATE/$U.progress"
  touch "$STATE/$U.frozen" "$LIST" "$FAIL"

  log "deep-scan begin user=$U"
  prepare_target_files "$U" "$TMP"

  if [ ! -f "$STATE/$U.thawing" ]; then
    suspend_batch_parallel "$U" "$TMP/candidates" "$TMP/system" "$LIST" "$FAIL" "$PROGRESS" "$TMP"
  fi

  if [ -f "$STATE/$U.thawing" ]; then
    log "deep-scan cancelled by thaw user=$U"
  else
    C="$(wc -l < "$LIST" 2>/dev/null | tr -d ' ')"
    FAILED="$(grep -c '^failed:' "$FAIL" 2>/dev/null || true)"
    PROTECTED="$(grep -c '^protected:' "$FAIL" 2>/dev/null || true)"
    log "deep-scan complete user=$U suspended=$C protected=$PROTECTED failed=$FAILED"
  fi

  rm -rf "$TMP"
  rm -f "$STATE/$U.scanning"
  rmdir "$LOCK" 2>/dev/null
  return 0
}

queue_freeze_user() {
  U="$1"
  valid_user "$U" || { die "invalid user: $U"; return 1; }
  user_exists "$U" || { die "user $U does not exist"; return 1; }

  CUR="$(current_user)"
  [ "$U" = "$CUR" ] && { die "user $U is current foreground user; switch back to user 0 first"; return 1; }

  rm -f "$STATE/$U.thawing"
  touch "$STATE/$U.frozen" "$STATE/$U.pending"
  [ -f "$STATE/$U.list" ] || : > "$STATE/$U.list"
  [ -f "$STATE/$U.fail" ] || : > "$STATE/$U.fail"
  chmod 600 "$STATE/$U.frozen" "$STATE/$U.pending" "$STATE/$U.list" "$STATE/$U.fail" 2>/dev/null

  am stop-user -f "$U" >/dev/null 2>&1
  unmount_share "$U"

  echo "user $U stopped immediately; deep package freeze queued"
  log "freeze queued user=$U"
  return 0
}

process_pending() {
  JOBS=0
  for F in "$STATE"/*.pending; do
    [ -f "$F" ] || continue
    U="$(basename "$F" .pending)"
    valid_user "$U" || { rm -f "$F"; continue; }
    [ -f "$STATE/$U.thawing" ] && { rm -f "$F"; continue; }

    deep_scan_user "$U" &
    JOBS=$((JOBS + 1))
    if [ "$JOBS" -ge "$PARALLEL_USERS" ]; then
      wait
      JOBS=0
    fi
  done
  wait
}

unsuspend_parallel() {
  U="$1"
  TMP="$STATE/.thaw.$U.$$"
  mkdir -p "$TMP"
  all_packages "$U" > "$TMP/all"
  IDX=0
  BATCH=0

  while IFS= read -r P; do
    [ -n "$P" ] || continue
    IDX=$((IDX + 1))
    BATCH=$((BATCH + 1))
    RES="$TMP/result.$IDX"
    (
      OUT="$(pm unsuspend --user "$U" "$P" 2>&1)"
      RC=$?
      ONE="$(echo "$OUT" | tr '\r\n|' '   ')"
      if [ "$RC" -eq 0 ]; then
        echo "OK|$P" > "$RES"
      elif is_pkg_suspended "$U" "$P"; then
        echo "FAIL|$P|$ONE" > "$RES"
      else
        echo "OK|$P" > "$RES"
      fi
    ) &

    if [ "$BATCH" -ge "$PARALLEL_PACKAGES" ]; then
      wait
      BATCH=0
    fi
  done < "$TMP/all"
  wait

  : > "$TMP/retry"
  for R in "$TMP"/result.*; do
    [ -f "$R" ] || continue
    [ "$(cut -d'|' -f1 "$R")" = "FAIL" ] && cut -d'|' -f2 "$R" >> "$TMP/retry"
  done

  if [ -s "$TMP/retry" ]; then
    sleep 1
    while IFS= read -r P; do
      [ -n "$P" ] || continue
      pm unsuspend --user "$U" "$P" >/dev/null 2>&1
    done < "$TMP/retry"
  fi

  FAILN=0
  if [ -s "$TMP/retry" ]; then
    : > "$STATE/$U.unsuspend_fail"
    while IFS= read -r P; do
      [ -n "$P" ] || continue
      if is_pkg_suspended "$U" "$P"; then
        echo "$P" >> "$STATE/$U.unsuspend_fail"
        FAILN=$((FAILN + 1))
      fi
    done < "$TMP/retry"
  fi

  rm -rf "$TMP"
  echo "$FAILN"
}

thaw_user() {
  U="$1"
  valid_user "$U" || { die "invalid user: $U"; return 1; }
  user_exists "$U" || { die "user $U does not exist"; return 1; }

  touch "$STATE/$U.thawing"
  rm -f "$STATE/$U.pending"
  chmod 600 "$STATE/$U.thawing" 2>/dev/null
  log "thaw begin user=$U"

  N=0
  while [ -d "$STATE/$U.scanlock" ] && [ "$N" -lt 30 ]; do
    sleep 1
    N=$((N + 1))
  done

  FAILN="$(unsuspend_parallel "$U")"

  rm -f "$STATE/$U.list" "$STATE/$U.retry" "$STATE/$U.fail" \
        "$STATE/$U.frozen" "$STATE/$U.progress" "$STATE/$U.scanning" "$STATE/$U.pending"

  am start-user -w "$U" >/dev/null 2>&1
  sleep 1
  sync_running_share "$U"

  rm -f "$STATE/$U.thawing"
  log "thaw complete user=$U unsuspend_fail=$FAILN"

  if [ "$FAILN" -gt 0 ] 2>/dev/null; then
    echo "user $U thawed; $FAILN package(s) still report suspended, see $STATE/$U.unsuspend_fail"
  else
    rm -f "$STATE/$U.unsuspend_fail"
    echo "user $U fully thawed"
  fi
  return 0
}

maintain_frozen() {
  for M in "$STATE"/*.frozen "$STATE"/*.list; do
    [ -f "$M" ] || continue
    B="$(basename "$M")"
    U="${B%%.*}"
    valid_user "$U" || continue
    user_exists "$U" || continue
    [ -f "$STATE/$U.thawing" ] && continue
    [ -f "$STATE/$U.pending" ] && continue
    [ -f "$STATE/$U.scanning" ] && continue

    if is_running "$U"; then
      touch "$STATE/$U.pending"
      chmod 600 "$STATE/$U.pending" 2>/dev/null
    fi
  done
}

status_plain() {
  list_users | while IFS='|' read -r U N; do
    if [ -f "$STATE/$U.thawing" ]; then
      F="THAWING"
    elif [ -f "$STATE/$U.pending" ] || [ -f "$STATE/$U.scanning" ]; then
      F="FREEZING"
    elif [ -f "$STATE/$U.frozen" ] || [ -f "$STATE/$U.list" ]; then
      F="FROZEN"
    else
      F="NORMAL"
    fi

    is_running "$U" && R="RUNNING" || R="STOPPED"
    shared_ok "$U" && S="SHARED" || S="NO_SHARED"
    [ -f "$STATE/$U.list" ] && C="$(wc -l < "$STATE/$U.list" 2>/dev/null | tr -d ' ')" || C=0

    DONE="$C"; TOTAL="$C"
    if [ -f "$STATE/$U.progress" ]; then
      P="$(cat "$STATE/$U.progress" 2>/dev/null)"
      DONE="$(echo "$P" | cut -d'|' -f1)"
      TOTAL="$(echo "$P" | cut -d'|' -f2)"
    fi
    [ -n "$DONE" ] || DONE=0
    [ -n "$TOTAL" ] || TOTAL=0
    FAILN="$(grep -c '^failed:' "$STATE/$U.fail" 2>/dev/null || true)"

    echo "$U|$N|$F|$R|$S|$C|$DONE|$TOTAL|$FAILN"
  done
}

parallel_thaw_all() {
  JOBS=0
  RCFILE="$STATE/.thawall.$$"
  : > "$RCFILE"
  for U in $(list_users | cut -d'|' -f1); do
    (
      thaw_user "$U" >/dev/null 2>&1 || echo "$U" >> "$RCFILE"
    ) &
    JOBS=$((JOBS + 1))
    if [ "$JOBS" -ge "$PARALLEL_USERS" ]; then
      wait
      JOBS=0
    fi
  done
  wait
  if [ -s "$RCFILE" ]; then
    echo "thaw-all completed with failures: $(tr '\n' ' ' < "$RCFILE")"
    rm -f "$RCFILE"
    return 1
  fi
  rm -f "$RCFILE"
  echo "all spaces thawed"
  return 0
}

case "$1" in
  status)
    status_plain
    ;;
  freeze|deep-freeze)
    shift
    [ "$#" -gt 0 ] || { die "usage: usershubctl freeze USER..."; exit 1; }
    RC=0
    for U in "$@"; do queue_freeze_user "$U" || RC=1; done
    exit "$RC"
    ;;
  freeze-all)
    CUR="$(current_user)"
    RC=0
    N=0
    for U in $(list_users | cut -d'|' -f1); do
      [ "$U" = "$CUR" ] && continue
      queue_freeze_user "$U" >/dev/null 2>&1 || RC=1
      N=$((N + 1))
    done
    echo "$N space(s) stopped immediately; deep gray-icon freeze continues in background"
    exit "$RC"
    ;;
  deep-scan)
    valid_user "$2" || { die "usage: usershubctl deep-scan USER"; exit 1; }
    deep_scan_user "$2"
    ;;
  process-pending)
    process_pending
    ;;
  thaw|unfreeze|force-thaw)
    shift
    [ "$#" -gt 0 ] || { die "usage: usershubctl thaw USER..."; exit 1; }
    RC=0; for U in "$@"; do thaw_user "$U" || RC=1; done; exit "$RC"
    ;;
  thaw-all|force-thaw-all)
    parallel_thaw_all
    ;;
  rescue-all)
    parallel_thaw_all
    RC=$?
    rm -f "$BOOT_FLAG"
    echo "rescue complete; boot auto-freeze disabled until: usershubctl boot-freeze on"
    exit "$RC"
    ;;
  boot-freeze)
    case "$2" in
      on) touch "$BOOT_FLAG"; chmod 600 "$BOOT_FLAG" 2>/dev/null; echo "boot auto-freeze enabled" ;;
      off) rm -f "$BOOT_FLAG"; echo "boot auto-freeze disabled" ;;
      status|'') [ -f "$BOOT_FLAG" ] && echo "boot auto-freeze: on" || echo "boot auto-freeze: off" ;;
      *) die "usage: usershubctl boot-freeze on|off|status"; exit 1 ;;
    esac
    ;;
  maintain-frozen)
    maintain_frozen
    ;;
  share)
    valid_user "$2" || { die "usage: usershubctl share USER"; exit 1; }
    sync_running_share "$2" && echo "Shared synced for running user $2" || { die "Shared sync failed for user $2"; exit 1; }
    ;;
  share-all)
    command -v usershubshare >/dev/null 2>&1 && usershubshare all
    ;;
  *)
    cat <<'EOF'
UsersHub Core 1.3.0
  usershubctl status --plain
  usershubctl freeze 10
  usershubctl freeze-all
  usershubctl deep-scan 10
  usershubctl process-pending
  usershubctl thaw 10
  usershubctl thaw-all
  usershubctl maintain-frozen
  usershubctl share-all
  usershubctl rescue-all
  usershubctl boot-freeze on|off|status
EOF
    exit 1
    ;;
esac
