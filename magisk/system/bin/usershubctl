#!/system/bin/sh

BASE="/data/adb/usershub"
STATE="$BASE/frozen"
LOG="$BASE/usershub.log"
BOOT_FLAG="$BASE/boot_freeze_enabled"
SRC="/data/media/0/Download/Shared"

mkdir -p "$STATE" 2>/dev/null
touch "$LOG" 2>/dev/null
chmod 700 "$BASE" "$STATE" 2>/dev/null
chmod 600 "$LOG" 2>/dev/null

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
die() { echo "ERROR: $*"; log "ERROR $*"; return 1; }

valid_user() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 10 ] 2>/dev/null && [ "$1" -lt 900 ] 2>/dev/null
}

user_exists() { cmd user list 2>/dev/null | grep -q "UserInfo{$1:"; }
current_user() { am get-current-user 2>/dev/null | tr -dc '0-9'; }
list_users_raw() { cmd user list 2>/dev/null || pm list users 2>/dev/null; }

list_users() {
  list_users_raw | sed -n 's/.*UserInfo{\([0-9][0-9]*\):\([^:}]*\):.*/\1|\2/p' |
  while IFS='|' read -r U N; do
    valid_user "$U" || continue
    N="$(echo "$N" | tr '|' ' ')"
    echo "$U|$N"
  done
}

is_running() {
  U="$1"
  R="$(am is-user-stopped "$U" 2>/dev/null | tail -n1 | tr -d '\r\n ')"
  [ "$R" = "false" ] && return 0
  [ "$R" = "true" ] && return 1
  S="$(am get-started-user-state "$U" 2>/dev/null)"
  echo "$S" | grep -qiE 'RUNNING|BOOTING' && return 0
  return 1
}

is_pkg_suspended() {
  U="$1"; P="$2"
  dumpsys package "$P" 2>/dev/null |
    grep -E "User[[:space:]]+$U:|User $U:" |
    grep -qE 'suspended=true|suspended: true'
}

pkg_installed_for_user() {
  U="$1"; P="$2"
  pm list packages --user "$U" "$P" 2>/dev/null | grep -qx "package:$P"
}

is_system_pkg() {
  U="$1"; P="$2"
  pm list packages -s --user "$U" "$P" 2>/dev/null | grep -qx "package:$P"
}

all_packages() {
  U="$1"
  pm list packages --user "$U" 2>/dev/null | sed 's/^package://' | sed '/^$/d' | sort -u
}

home_packages() {
  U="$1"
  OUT="$(cmd package query-activities --brief --user "$U" -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null)"
  echo "$OUT" | sed -n 's#^[[:space:]]*\([^[:space:]/][^/]*\)/.*#\1#p'
  RES="$(cmd package resolve-activity --brief --user "$U" -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null)"
  echo "$RES" | sed -n 's#^[[:space:]]*\([^[:space:]/][^/]*\)/.*#\1#p'
}

default_ime_pkg() {
  U="$1"
  settings --user "$U" get secure default_input_method 2>/dev/null | sed 's#/.*##' | head -n1
}

is_critical_pkg() {
  U="$1"; P="$2"
  case "$P" in
    android|com.android.systemui|com.android.shell|com.captainsss.usershub|\
    com.android.permissioncontroller|com.google.android.permissioncontroller|\
    com.android.packageinstaller|com.google.android.packageinstaller|com.miui.packageinstaller|\
    com.android.providers.settings|com.android.providers.media|com.android.providers.media.module|\
    com.android.providers.downloads|com.android.externalstorage|\
    com.android.phone|com.android.server.telecom|com.android.providers.telephony|\
    com.miui.home|com.android.launcher3|com.mi.android.globallauncher|\
    com.miui.securitycenter|com.lbe.security.miui|com.miui.core|com.miui.core.internal.services)
      return 0
      ;;
  esac

  home_packages "$U" | sort -u | grep -Fxq "$P" && return 0
  IME="$(default_ime_pkg "$U")"
  [ -n "$IME" ] && [ "$P" = "$IME" ] && return 0
  return 1
}

collect_candidates() {
  U="$1"
  all_packages "$U"
}

shared_ok() {
  U="$1"; DST="/data/media/$U/Download/Shared"
  grep -Fq " $DST " /proc/mounts 2>/dev/null
}

unmount_share() {
  U="$1"
  if command -v usershubshare >/dev/null 2>&1; then
    usershubshare unmount "$U" >/dev/null 2>&1
    return 0
  fi
  DST="/data/media/$U/Download/Shared"
  if shared_ok "$U"; then
    if command -v su >/dev/null 2>&1; then
      su -M -c "umount '$DST' 2>/dev/null" >/dev/null 2>&1
    else
      umount "$DST" >/dev/null 2>&1
    fi
  fi
}

sync_running_share() {
  U="$1"
  command -v usershubshare >/dev/null 2>&1 || return 0
  usershubshare user "$U" >/dev/null 2>&1
}

clean_owned_list() {
  U="$1"; LIST="$2"
  TMP="$LIST.clean.$$"
  : > "$TMP"
  [ -f "$LIST" ] || { mv "$TMP" "$LIST"; return 0; }

  while IFS= read -r P; do
    [ -n "$P" ] || continue
    if ! pkg_installed_for_user "$U" "$P"; then
      continue
    fi
    if is_critical_pkg "$U" "$P"; then
      pm unsuspend --user "$U" "$P" >/dev/null 2>&1
      log "released newly-critical package user=$U package=$P"
      continue
    fi
    echo "$P" >> "$TMP"
  done < "$LIST"

  sort -u "$TMP" -o "$TMP" 2>/dev/null
  mv "$TMP" "$LIST"
  chmod 600 "$LIST" 2>/dev/null
}

suspend_one() {
  U="$1"; P="$2"; OUTFILE="$3"
  OUT="$(pm suspend --user "$U" "$P" 2>&1)"
  RC=$?
  echo "$OUT" > "$OUTFILE"
  if [ "$RC" -eq 0 ] && ! echo "$OUT" | grep -qiE 'Failure|Error|not allowed|cannot suspend|not suspendable'; then
    return 0
  fi
  is_pkg_suspended "$U" "$P"
}

reconcile_frozen_user() {
  U="$1"
  LIST="$STATE/$U.list"
  FAIL="$STATE/$U.fail"

  # Critical v1.2.4 fix: never re-suspend packages while the user is being
  # thawed. Older builds could race the long unsuspend loop and make icons gray
  # again before thaw finished.
  [ -f "$STATE/$U.thawing" ] && return 0
  [ -f "$LIST" ] || return 0

  clean_owned_list "$U" "$LIST"
  FAILTMP="$FAIL.tmp.$$"
  : > "$FAILTMP"

  collect_candidates "$U" |
  while IFS= read -r P; do
    [ -n "$P" ] || continue

    if is_critical_pkg "$U" "$P"; then
      echo "critical:$P" >> "$FAILTMP"
      continue
    fi

    if grep -Fxq "$P" "$LIST" 2>/dev/null; then
      continue
    fi

    # A package may already be suspended by an older UsersHub build but not
    # recorded because MIUI's dumpsys format confused the old verifier. When
    # this user is already owned by UsersHub freeze state, adopt that package
    # into our list so normal thaw can recover it too.
    if is_pkg_suspended "$U" "$P"; then
      echo "$P" >> "$LIST"
      echo "adopted:$P" >> "$FAILTMP"
      log "adopted existing suspension into UsersHub state user=$U package=$P"
      continue
    fi

    OUTTMP="$STATE/.suspend.$U.$$"
    if suspend_one "$U" "$P" "$OUTTMP"; then
      echo "$P" >> "$LIST"
      if is_system_pkg "$U" "$P"; then
        log "deep-freeze user=$U suspended SYSTEM package=$P"
      else
        log "deep-freeze user=$U suspended package=$P"
      fi
    else
      OUT="$(cat "$OUTTMP" 2>/dev/null)"
      if is_system_pkg "$U" "$P"; then
        echo "protected:$P:$OUT" >> "$FAILTMP"
        log "protected system package skipped user=$U package=$P out=$OUT"
      else
        echo "failed:$P:$OUT" >> "$FAILTMP"
        log "suspend failed user=$U package=$P out=$OUT"
      fi
    fi
    rm -f "$OUTTMP"
  done

  sort -u "$LIST" -o "$LIST" 2>/dev/null
  sort -u "$FAILTMP" -o "$FAILTMP" 2>/dev/null
  mv "$FAILTMP" "$FAIL"
  chmod 600 "$LIST" "$FAIL" 2>/dev/null
}

freeze_user() {
  U="$1"
  valid_user "$U" || { die "invalid user: $U"; return 1; }
  user_exists "$U" || { die "user $U does not exist"; return 1; }

  CUR="$(current_user)"
  [ "$U" = "$CUR" ] && { die "user $U is current foreground user; switch back to user 0 first"; return 1; }

  rm -f "$STATE/$U.thawing"
  LIST="$STATE/$U.list"
  FAIL="$STATE/$U.fail"
  [ -f "$LIST" ] || : > "$LIST"
  [ -f "$FAIL" ] || : > "$FAIL"
  chmod 600 "$LIST" "$FAIL" 2>/dev/null

  reconcile_frozen_user "$U"
  am stop-user -w -f "$U" >/dev/null 2>&1
  unmount_share "$U"

  C="$(wc -l < "$LIST" 2>/dev/null | tr -d ' ')"
  FAILED="$(grep -c '^failed:' "$FAIL" 2>/dev/null || true)"
  PROTECTED="$(grep -c '^protected:' "$FAIL" 2>/dev/null || true)"
  ADOPTED="$(grep -c '^adopted:' "$FAIL" 2>/dev/null || true)"
  CRIT="$(grep -c '^critical:' "$FAIL" 2>/dev/null || true)"
  log "deep-freeze user=$U suspended=$C adopted=$ADOPTED protected=$PROTECTED critical=$CRIT failed=$FAILED"
  echo "user $U deep-frozen: suspended=$C, adopted=$ADOPTED, protected=$PROTECTED, critical=$CRIT, failed=$FAILED"
  [ "$FAILED" -eq 0 ] 2>/dev/null
}

force_unsuspend_all() {
  U="$1"
  FAILFILE="$STATE/$U.unsuspend_fail"
  : > "$FAILFILE"
  OK=0; FAILN=0

  # Full-space thaw semantics: restore the whole user's package suspension
  # state to normal. This intentionally repairs untracked suspensions left by
  # earlier UsersHub versions, which is what caused gray icons after thaw.
  all_packages "$U" |
  while IFS= read -r P; do
    [ -n "$P" ] || continue
    OUT="$(pm unsuspend --user "$U" "$P" 2>&1)"
    RC=$?
    if [ "$RC" -ne 0 ] && is_pkg_suspended "$U" "$P"; then
      echo "$P|$OUT" >> "$FAILFILE"
    fi
  done

  # A second pass handles packages whose state changed while PackageManager was
  # waking the user/profile or while older package state was being migrated.
  sleep 1
  all_packages "$U" |
  while IFS= read -r P; do
    [ -n "$P" ] || continue
    pm unsuspend --user "$U" "$P" >/dev/null 2>&1
  done

  [ -s "$FAILFILE" ] && FAILN="$(wc -l < "$FAILFILE" | tr -d ' ')" || FAILN=0
  echo "$FAILN"
}

thaw_user() {
  U="$1"
  valid_user "$U" || { die "invalid user: $U"; return 1; }
  user_exists "$U" || { die "user $U does not exist"; return 1; }

  # Lock out maintain-frozen immediately, before any unsuspend command starts.
  touch "$STATE/$U.thawing"
  chmod 600 "$STATE/$U.thawing" 2>/dev/null
  log "thaw begin user=$U"

  FAILN="$(force_unsuspend_all "$U")"

  # Remove all old ownership metadata only after the unsuspend passes complete.
  rm -f "$STATE/$U.list" "$STATE/$U.retry" "$STATE/$U.fail"

  am start-user -w "$U" >/dev/null 2>&1
  sleep 1
  sync_running_share "$U"

  rm -f "$STATE/$U.thawing"
  log "thaw complete user=$U unsuspend_fail=$FAILN"

  if [ "$FAILN" -gt 0 ] 2>/dev/null; then
    echo "user $U thawed; $FAILN package(s) reported unsuspend errors, second pass attempted; see $STATE/$U.unsuspend_fail"
  else
    rm -f "$STATE/$U.unsuspend_fail"
    echo "user $U fully thawed; all installed packages unsuspend pass completed"
  fi
  return 0
}

status_plain() {
  list_users | while IFS='|' read -r U N; do
    if [ -f "$STATE/$U.thawing" ]; then
      F="THAWING"
    elif [ -f "$STATE/$U.list" ]; then
      F="FROZEN"
    else
      F="NORMAL"
    fi
    is_running "$U" && R="RUNNING" || R="STOPPED"
    shared_ok "$U" && S="SHARED" || S="NO_SHARED"
    if [ -f "$STATE/$U.list" ]; then C="$(wc -l < "$STATE/$U.list" 2>/dev/null | tr -d ' ')"; else C=0; fi
    echo "$U|$N|$F|$R|$S|$C"
  done
}

case "$1" in
  status)
    status_plain
    ;;
  freeze|deep-freeze)
    shift
    [ "$#" -gt 0 ] || { die "usage: usershubctl freeze USER..."; exit 1; }
    RC=0; for U in "$@"; do freeze_user "$U" || RC=1; done; exit "$RC"
    ;;
  thaw|unfreeze|force-thaw)
    shift
    [ "$#" -gt 0 ] || { die "usage: usershubctl thaw USER..."; exit 1; }
    RC=0; for U in "$@"; do thaw_user "$U" || RC=1; done; exit "$RC"
    ;;
  freeze-all)
    CUR="$(current_user)"; RC=0
    for U in $(list_users | cut -d'|' -f1); do [ "$U" = "$CUR" ] && continue; freeze_user "$U" || RC=1; done
    exit "$RC"
    ;;
  thaw-all|force-thaw-all)
    RC=0; for U in $(list_users | cut -d'|' -f1); do thaw_user "$U" || RC=1; done; exit "$RC"
    ;;
  rescue-all)
    RC=0
    for U in $(list_users | cut -d'|' -f1); do thaw_user "$U" || RC=1; done
    rm -f "$BOOT_FLAG"
    echo "rescue complete; boot auto-freeze disabled until: usershubctl boot-freeze on"
    exit "$RC"
    ;;
  boot-freeze)
    case "$2" in
      on) touch "$BOOT_FLAG"; chmod 600 "$BOOT_FLAG" 2>/dev/null; echo "boot auto-freeze enabled" ;;
      off) rm -f "$BOOT_FLAG"; echo "boot auto-freeze disabled" ;;
      status|'') [ -f "$BOOT_FLAG" ] && echo "boot auto-freeze: on" || echo "boot auto-freeze: off" ;;
      *) die "usage: usershubctl boot-freeze on|off|status"; exit 1 ;;
    esac
    ;;
  maintain-frozen)
    for F in "$STATE"/*.list; do
      [ -f "$F" ] || continue
      U="$(basename "$F" .list)"
      valid_user "$U" || continue
      user_exists "$U" || continue
      [ -f "$STATE/$U.thawing" ] && continue
      reconcile_frozen_user "$U"
    done
    ;;
  share)
    valid_user "$2" || { die "usage: usershubctl share USER"; exit 1; }
    sync_running_share "$2" && echo "Shared synced for running user $2" || { die "Shared sync failed for user $2"; exit 1; }
    ;;
  share-all)
    command -v usershubshare >/dev/null 2>&1 && usershubshare all
    ;;
  *)
    cat <<'EOF'
UsersHub Core 1.2.4
  usershubctl status --plain
  usershubctl freeze 10
  usershubctl thaw 10
  usershubctl force-thaw 10
  usershubctl freeze-all
  usershubctl thaw-all
  usershubctl force-thaw-all
  usershubctl maintain-frozen
  usershubctl share-all
  usershubctl rescue-all
  usershubctl boot-freeze on|off|status
EOF
    exit 1
    ;;
esac
