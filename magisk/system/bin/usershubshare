#!/system/bin/sh

BASE="/data/adb/usershub"
LOG="$BASE/usershub.log"
SRC="/data/media/0/Download/Shared"

mkdir -p "$BASE" 2>/dev/null
touch "$LOG" 2>/dev/null

log() { echo "$(date '+%F %T') [shared] $*" >> "$LOG"; }

valid_user() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 10 ] 2>/dev/null && [ "$1" -lt 900 ] 2>/dev/null
}

list_users() {
  OUT="$(cmd user list 2>/dev/null)"
  [ -n "$OUT" ] || OUT="$(pm list users 2>/dev/null)"
  echo "$OUT" | sed -n 's/.*UserInfo{\([0-9][0-9]*\):.*/\1/p' |
  while IFS= read -r U; do valid_user "$U" && echo "$U"; done
}

is_running() {
  U="$1"
  S="$(am get-started-user-state "$U" 2>/dev/null | tr '\r\n' ' ')"
  echo "$S" | grep -qiE 'RUNNING|BOOTING'
}

is_frozen() {
  U="$1"
  [ -f "$BASE/frozen/$U.frozen" ] || [ -f "$BASE/frozen/$U.pending" ] || [ -f "$BASE/frozen/$U.scanning" ]
}

shared_ok() {
  U="$1"
  DST="/data/media/$U/Download/Shared"
  grep -Fq " $DST " /proc/mounts 2>/dev/null
}

global_exec() {
  CMD="$1"
  if command -v su >/dev/null 2>&1; then
    su -M -c "$CMD" >/dev/null 2>&1
  else
    sh -c "$CMD" >/dev/null 2>&1
  fi
}

unmount_shared() {
  U="$1"
  DST="/data/media/$U/Download/Shared"
  if shared_ok "$U"; then
    global_exec "umount '$DST' 2>/dev/null"
    if shared_ok "$U"; then
      log "user=$U Shared unmount failed"
      echo "ERROR user $U: Shared unmount failed"
      return 1
    fi
    log "user=$U Shared unmounted"
  fi
  rmdir "$DST" 2>/dev/null || true
  echo "user $U: Shared not mounted"
  return 0
}

mount_running_shared() {
  U="$1"
  valid_user "$U" || return 1

  # A frozen or not-yet-started user never gets Shared mounted.
  if is_frozen "$U" || ! is_running "$U"; then
    unmount_shared "$U"
    return $?
  fi

  if [ ! -d "$SRC" ]; then
    echo "ERROR user $U: real source missing: $SRC"
    log "user=$U source missing: $SRC"
    return 1
  fi

  N=0
  while [ ! -d "/data/media/$U" ] && [ "$N" -lt 20 ]; do
    sleep 1
    N=$((N + 1))
  done
  if [ ! -d "/data/media/$U" ]; then
    echo "ERROR user $U: running but real media storage is not ready"
    log "user=$U running but /data/media/$U missing"
    return 1
  fi

  if shared_ok "$U"; then
    echo "user $U: real Shared already mounted"
    return 0
  fi

  mkdir -p "/data/media/$U/Download" 2>/dev/null || return 1
  mkdir -p "/data/media/$U/Download/Shared" 2>/dev/null || return 1
  DST="/data/media/$U/Download/Shared"
  global_exec "mount --bind '$SRC' '$DST'"

  if shared_ok "$U"; then
    echo "user $U: running, real Shared mounted"
    log "user=$U real Shared mounted"
    return 0
  fi

  echo "ERROR user $U: real Shared bind mount failed"
  log "user=$U real Shared bind mount failed"
  return 1
}

case "$1" in
  all|sync-all|'')
    RC=0
    for U in $(list_users); do mount_running_shared "$U" || RC=1; done
    exit "$RC"
    ;;
  user|sync)
    valid_user "$2" || { echo "usage: usershubshare user USER_ID"; exit 1; }
    mount_running_shared "$2"
    ;;
  unmount)
    valid_user "$2" || { echo "usage: usershubshare unmount USER_ID"; exit 1; }
    unmount_shared "$2"
    ;;
  status)
    for U in $(list_users); do
      if is_running "$U"; then R=RUNNING; else R=STOPPED; fi
      if shared_ok "$U"; then S=SHARED; else S=NO_SHARED; fi
      if [ -d "/data/media/$U" ]; then M=MEDIA_READY; else M=MEDIA_MISSING; fi
      echo "$U|$R|$S|$M"
    done
    ;;
  *)
    echo "UsersHub real Shared lifecycle"
    echo "  usershubshare all"
    echo "  usershubshare user 10"
    echo "  usershubshare unmount 10"
    echo "  usershubshare status"
    exit 1
    ;;
esac
